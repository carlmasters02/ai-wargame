# --- Neo4j Aura (free tier) ---
# Copy all three from the Aura credentials file.
# NOTE: NEO4J_USER is the INSTANCE ID (e.g. a1b2c3d4), not "neo4j".
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=xxxxxxxx
NEO4J_PASSWORD=your-aura-password

# --- ai& inference API (OpenAI-compatible) ---
AIAND_API_KEY=your-aiand-key
AIAND_BASE_URL=https://api.aiand.example/v1

# --- Model routing (confirm exact IDs with scripts/check_models.py) ---
ATTACKER_MODEL=deepseek-ai/deepseek-v4-pro
DEFENDER_MODEL=moonshotai/kimi-k3
REPORT_MODEL=moonshotai/kimi-k3

# --- Game ---
GAME_SEED=42
MAX_TURNS=20
PATH_METRIC_IMPL=python
