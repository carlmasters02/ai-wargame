# --- Neo4j Aura (free tier) ---
# Copy all three from the Aura credentials file.
# NOTE: NEO4J_USER is the INSTANCE ID (e.g. a1b2c3d4), not "neo4j".
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=xxxxxxxx
NEO4J_PASSWORD=your-aura-password

# --- ai& inference API (OpenAI-compatible) ---
AIAND_API_KEY=your-aiand-key
AIAND_BASE_URL=https://api.aiand.example/v1

# --- Model routing (confirm exact IDs with scripts/check_models.py) ---
ATTACKER_MODEL=deepseek-ai/deepseek-v4-pro
DEFENDER_MODEL=moonshotai/kimi-k3
REPORT_MODEL=moonshotai/kimi-k3

# --- Game ---
GAME_SEED=42
MAX_TURNS=20
PATH_METRIC_IMPL=python

# --- Report ---
REPORT_TIMEOUT=180

# --- Access control (set before exposing the server publicly) ---
# Empty = local-only (the server answers localhost requests only).
# If set, every control endpoint needs this token; open the page once with #token=...
WARGAME_TOKEN=

# --- Cross-provider benchmarking (optional) ---
# JSON map of provider prefix -> endpoint. A model id "openai:gpt-4o" then routes here;
# a bare id uses ai& (AIAND_*). Lets RED and BLUE run on different providers.
# MODEL_PROVIDERS={"openai":{"base_url":"https://api.openai.com/v1","api_key":"sk-..."},"anthropic":{"base_url":"https://api.anthropic.com/v1","api_key":"..."}}
MODEL_PROVIDERS={}
