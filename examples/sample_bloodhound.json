  "_comment": "Simplified BloodHound-style identity graph. sessions = who is logged in; admins = local admins; admin_to = computers a user can administer.",
  "computers": [
    {"name": "WKS-ALICE",  "sessions": ["ALICE"], "admins": ["HELPDESK"]},
    {"name": "WKS-BOB",    "sessions": ["BOB"],   "admins": ["HELPDESK"]},
    {"name": "FILE01",     "sessions": ["SVC-BACKUP"], "admins": ["BOB"]},
